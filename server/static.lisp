;;;; -*- mode: lisp -*-

(in-package #:mtm-server)

;;; Static assets.
;;;
;;; Production: every file under public/ is embedded into the image by
;;; tools/build-static.lisp as base64 (see the generated static-assets.lisp),
;;; so the binary serves the game with no filesystem at all.
;;;
;;; Development: the same file is read from disk first, which is what makes
;;; `shadow-cljs watch` + reload work without rebuilding the server.

(defvar *static-assets* nil
  "Alist of (relative-path . base64-string), generated by tools/build-static.lisp.")

(defvar *static-assets-cache* (make-hash-table :test #'equal)
  "Decoded assets keyed by relative path.")

(defun read-file-bytes (file)
  "Read FILE as an octet vector."
  (with-open-file (s file :direction :input :element-type '(unsigned-byte 8))
    (let ((data (make-array (file-length s) :element-type '(unsigned-byte 8))))
      (read-sequence data s)
      data)))

(defun list-static-files (dir)
  "Recursively list every file under DIR."
  (let ((result '()))
    (labels ((walk (d)
               (dolist (entry (uiop:directory-files d))
                 (push entry result))
               (dolist (sub (uiop:subdirectories d))
                 (walk sub))))
      (walk (uiop:ensure-directory-pathname dir)))
    (sort result #'string< :key #'file-namestring)))

(defun static-asset-bytes (rel)
  "Octet vector of REL embedded in the image, or NIL."
  (or (gethash rel *static-assets-cache*)
      (let ((entry (find rel *static-assets* :test #'string= :key #'car)))
        (when entry
          (let ((bytes (cl-base64:base64-string-to-usb8-array (cdr entry))))
            (setf (gethash rel *static-assets-cache*) bytes)
            bytes)))))

(defun static-asset-paths ()
  "All embedded asset paths."
  (mapcar #'car *static-assets*))

(defun reload-static-assets (&optional (dir "public/"))
  "Hot-reload DIR into a running image - handy while the frontend rebuilds."
  (let* ((root (uiop:ensure-absolute-pathname
                (uiop:ensure-directory-pathname dir)
                (uiop:getcwd)))
         (assets (mapcar (lambda (file)
                           (cons (namestring (uiop:enough-pathname file root))
                                 (cl-base64:usb8-array-to-base64-string
                                  (read-file-bytes file) :columns 0)))
                         (list-static-files root))))
    (setf *static-assets* assets)
    (clrhash *static-assets-cache*)
    (length assets)))
