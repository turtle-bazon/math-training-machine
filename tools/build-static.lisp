;;;; -*- mode: lisp -*-
;;;;
;;;; Bakes every file under public/ into server/static-assets.lisp as base64,
;;;; so the built binary serves the game without touching the filesystem.
;;;;
;;;;   sbcl --non-interactive --load tools/build-static.lisp
;;;;
;;;; Run it after `npx shadow-cljs release app` (the Makefile does this).

(in-package :cl-user)

(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))

(ql:quickload "cl-base64" :silent t)

(defparameter *static-dir* "public/")
(defparameter *output-file* "server/static-assets.lisp")

(defun abs-static-dir ()
  (uiop:ensure-absolute-pathname
   (uiop:ensure-directory-pathname *static-dir*)
   (uiop:getcwd)))

(defun list-static-files (dir)
  (let ((result '()))
    (labels ((walk (d)
               (dolist (entry (uiop:directory-files d))
                 (push entry result))
               (dolist (sub (uiop:subdirectories d))
                 (walk sub))))
      (walk (uiop:ensure-directory-pathname dir)))
    (sort result #'string< :key #'file-namestring)))

(defun read-file-bytes (file)
  (with-open-file (s file :direction :input :element-type '(unsigned-byte 8))
    (let ((data (make-array (file-length s) :element-type '(unsigned-byte 8))))
      (read-sequence data s)
      data)))

(defun build-static-assets ()
  (let ((root (abs-static-dir)))
    (unless (probe-file root)
      (format *error-output* "~&[mtm] no such directory: ~a (build the frontend first)~%" root)
      (uiop:quit 1))
    (ensure-directories-exist *output-file*)
    (with-open-file (stream *output-file* :direction :output :if-exists :supersede)
      (format stream ";;; -*- mode: lisp -*-~%~%")
      (format stream ";;; Generated by tools/build-static.lisp - do not edit by hand.~%~%")
      (format stream "(in-package #:mtm-server)~%~%")
      (format stream "(defparameter *static-assets*~%  '(~%")
      (let ((files (list-static-files root))
            (total 0))
        (dolist (file files)
          (let ((path (namestring (uiop:enough-pathname file root)))
                (bytes (read-file-bytes file)))
            (incf total (length bytes))
            (format stream "    (\"~a\" . \"~a\")~%"
                    path
                    (cl-base64:usb8-array-to-base64-string bytes :columns 0))))
        (format stream "    ))~%")
        (format t "~&[mtm] embedded ~d file~:p (~:d bytes) into ~a~%"
                (length files) total *output-file*)))))

(build-static-assets)
(uiop:quit 0)
